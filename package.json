{
  "name": "work-continuity",
  "version": "0.7.1",
  "description": "A standalone macOS work-continuity app for local Codex and Claude Code sessions.",
  "main": "dist/desktop/main.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin && npm run build:desktop",
    "build:plugin": "node scripts/build-runtime-helper.mjs && node esbuild.config.mjs production",
    "build:desktop": "node scripts/build-desktop.mjs production",
    "dev": "node scripts/build-desktop.mjs development --watch",
    "dev:plugin": "node esbuild.config.mjs development --watch",
    "start:desktop": "npm run build:desktop && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/build-e2e.mjs && playwright test",
    "test:runtime-host": "node scripts/build-runtime-helper.mjs && node scripts/test-runtime-host.mjs",
    "test:obsidian": "node scripts/test-obsidian-local.mjs",
    "lint": "npm run typecheck && node scripts/privacy-check.mjs && node scripts/readme-check.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "release:plugin:macos": "npm run build:plugin && node scripts/build-release.mjs",
    "dist:macos": "npm run build:desktop && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:macos:arch": "npm run build:desktop && electron-builder --mac dmg zip --publish never",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:desktop-release": "node scripts/verify-desktop-release.mjs",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "keywords": [
    "macos",
    "electron",
    "work-continuity",
    "agent-whiteboard",
    "task-decomposition",
    "local-ai",
    "agent-sessions",
    "session-resume"
  ],
  "author": "WdBlink",
  "license": "MIT",
  "build": {
    "appId": "com.wdblink.workcontinuity",
    "productName": "Work Continuity",
    "directories": {
      "app": "dist/desktop",
      "output": "dist/macos",
      "buildResources": "app/desktop/assets"
    },
    "files": [
      "**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "app-icon.icns",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@playwright/test": "1.61.1",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.0",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "obsidian": "1.13.1",
    "tsx": "^4.22.5",
    "typescript": "6.0.3",
    "zod": "4.5.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.10.1",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.577.0",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
